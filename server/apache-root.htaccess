# DIP Studio – add ABOVE the "# BEGIN WordPress" block in the web-root .htaccess.
#
# Return 410 Gone for the old staging install (audit §1.1 #1, checklist #1).
# Works even while the /stagging/ folder still physically exists, because mod_alias rules in the
# parent .htaccess apply to sub-folders. Delete the folder afterwards anyway.
<IfModule mod_alias.c>
    RedirectMatch 410 ^/stagg?ing(/.*)?$
</IfModule>
# Re-audit §6: also send noindex, nofollow on those URLs (Apache 2.4+).
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/stagg?ing(/|$)#">
        Header always set X-Robots-Tag "noindex, nofollow"
    </If>
</IfModule>

# Date-prefixed duplicate blog URLs → root /%postname%/ (audit §1.1 #3).
# Only matches /YYYY/MM/DD/slug/ (4 segments) — the date archives themselves are handled by the
# mu-plugin, which knows whether a matching post exists.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/([^/]+)/?$ /$1/ [R=301,L]
</IfModule>
