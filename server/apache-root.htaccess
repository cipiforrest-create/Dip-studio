# DIP Studio – add ABOVE the "# BEGIN WordPress" block in the LIVE site's .htaccess
# (/home/…/dipstudio.ba/.htaccess, not the one inside /stagging/).
#
# /stagging/ is a separate WordPress install (staging copy). Live WordPress never sees those URLs,
# so the plugin can't hide them. This header tells Google to drop every /stagging/ URL from the index
# while the staging site keeps working for you (re-audit: "X-Robots-Tag: noindex, nofollow").
# Do NOT Disallow /stagging/ in robots.txt: Google must be able to fetch the pages to see the noindex.
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/stagg?ing(/|$)#">
        Header always set X-Robots-Tag "noindex, nofollow"
    </If>
</IfModule>

# Date-prefixed duplicate blog URLs → root /%postname%/.
# Only matches /YYYY/MM/DD/slug/ (4 segments); date archives are handled by the plugin.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/([^/]+)/?$ /$1/ [R=301,L]
</IfModule>
